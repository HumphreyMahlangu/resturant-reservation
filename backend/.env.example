# Supabase PostgreSQL connection.
# Copy this file to backend/.env or export these variables before starting Spring Boot.
# The password must never be committed.
SUPABASE_DB_URL=jdbc:postgresql://db.zicomlthqritmekbrsci.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=replace-with-your-supabase-database-password

# Keep schema changes controlled by migrations after the initial setup.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Admin dashboard credentials. Use a long, unique password.
APP_ADMIN_EMAIL=admin@your-domain.example
APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Base64-encoded secret, at least 32 bytes after decoding.
APP_SECURITY_JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
APP_SECURITY_JWT_EXPIRATION=PT8H
